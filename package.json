{
  "name": "personal-presentation-miguel-gutierrez",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --coverage",
    "test:watch": "ng test",
    "lint": "ng lint",
    "ci": "npm run lint && npm test && npm run build",
    "lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "studio": "npm --prefix studio run dev",
    "studio:install": "npm --prefix studio install",
    "studio:seed": "npm --prefix studio run seed",
    "studio:seed:dry": "npm --prefix studio run seed:dry"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.11"
  }
}
